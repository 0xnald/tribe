{
  "name": "tribe",
  "private": true,
  "version": "0.0.1",
  "description": "Tribe — a competitive ownership layer for markets on Solana.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @tribe/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --parallel lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
