# ---- Market layer (prices, logos, liquidity, market hours) ----
# mainnet-beta: xStocks and the real assets only exist there
NEXT_PUBLIC_MARKET_CLUSTER=mainnet-beta
NEXT_PUBLIC_MARKET_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Protocol layer (tribe_arena program) ----
# devnet during the hackathon; flip to mainnet-beta with a mainnet program id later
NEXT_PUBLIC_TRIBE_PROTOCOL_CLUSTER=devnet
NEXT_PUBLIC_TRIBE_PROTOCOL_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_TRIBE_PROGRAM_ID=shzfcWWZtWWTMfRuEvdBAsJZUe3mYork3wug5z5U5w4
# devnet stand-in mints -> the mainnet asset they represent (defaults are built in)
# NEXT_PUBLIC_DEVNET_ASSETS={"<mint>":{"standsFor":"BONK","label":"tBONK"}}

# ---- Mode: live (mainnet market data + fixtures) | demo (fixtures only, no external calls) ----
NEXT_PUBLIC_TRIBE_MODE=live
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server-side keys (never NEXT_PUBLIC_) ----
# Jupiter: optional; without a key the app uses lite-api.jup.ag (keyless)
JUPITER_API_KEY=
# Pyth Hermes: optional; feed metadata is public, price updates need a key
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_HERMES_API_KEY=
XSTOCKS_API_URL=https://api.xstocks.fi/api/v2
# Devnet faucet for tBONK/tSOL test tokens: JSON secret key or a file path of the mint authority
DEVNET_FAUCET_KEYPAIR=

# ---- Later phases ----
DATABASE_URL=
CRANK_KEYPAIR=
HELIUS_WEBHOOK_SECRET=
