{
  "schema": "tribe-core-vectors",
  "version": 1,
  "category": "fees",
  "engine": "@tribe/core reference implementation",
  "notes": "All integers are decimal strings (bigint). Rust: parse with u128/i128::from_str. Error outcomes are ErrorCode identifiers (see src/engine/errors.ts).",
  "vectors": [
    {
      "name": "100 USDC default",
      "description": "",
      "inputs": {
        "notionalUsdc": "100000000",
        "policy": {
          "feeBps": 50,
          "split": {
            "rewardPoolBps": 4000,
            "protocolBps": 4000,
            "creatorBps": 2000
          },
          "creatorShareTarget": "Creator"
        }
      },
      "expected": {
        "feeRequired": "500000",
        "split": {
          "toPool": "200000",
          "toProtocol": "200000",
          "toCreator": "100000",
          "creatorRoutedTo": "Creator"
        }
      }
    },
