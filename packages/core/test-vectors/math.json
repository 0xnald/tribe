{
  "schema": "tribe-core-vectors",
  "version": 1,
  "category": "math",
  "engine": "@tribe/core reference implementation",
  "notes": "All integers are decimal strings (bigint). Rust: parse with u128/i128::from_str. Error outcomes are ErrorCode identifiers (see src/engine/errors.ts).",
  "vectors": [
    {
      "name": "toQ10 expo -10 identity",
      "description": "$365.25 at expo -10",
      "inputs": {
        "op": "toQ10",
        "args": [
          "3652500000000"
        ],
        "numArgs": [
          -10
        ]
      },
      "expected": {
        "result": "3652500000000"
      }
    },
    {
      "name": "toQ10 expo -8 scales up",
      "description": "$365.25 at expo -8 (Pyth crypto/equity feeds) -> Q10",
      "inputs": {
        "op": "toQ10",
        "args": [
          "36525000000"
        ],
        "numArgs": [
          -8
        ]
      },
      "expected": {
        "result": "3652500000000"
      }
    },
    {
      "name": "toQ10 expo -2",
      "description": "$365.25 at expo -2",
      "inputs": {
        "op": "toQ10",
        "args": [
          "36525"
        ],
        "numArgs": [
          -2
        ]
      },
      "expected": {
        "result": "3652500000000"
      }
    },
    {
      "name": "toQ10 expo -15 floors",
      "description": "BONK 2816164455e-15 -> 28161 (floors the last five digits)",
      "inputs": {
        "op": "toQ10",
        "args": [
          "2816164455"
        ],
        "numArgs": [
          -15
        ]
      },
      "expected": {
        "result": "28161"
      }
    },
    {
      "name": "toQ10 BONK expo -10 keeps sub-cent resolution",
      "description": "$0.0000027100 -> 27 100 (Q8 would have been 271)",
      "inputs": {
        "op": "toQ10",
        "args": [
          "27100"
        ],
        "numArgs": [
          -10
        ]
      },
      "expected": {
        "result": "27100"
      }
    },
    {
      "name": "refPriceQ10 dividend 1.008",
      "description": "",
      "inputs": {
        "op": "refPriceQ10",
        "args": [
          "1000000000000",
          "1008000"
        ]
      },
      "expected": {
        "result": "1008000000000"
      }
    },
    {
      "name": "refPriceQ10 split 4x",
